# ============================================================
# Faro — variabili d'ambiente (SOLO per i test in locale)
# Copia questo file in `.env` e riempi i valori.
# In produzione (GitHub Actions) le chiavi vivono nei GitHub
# Secrets, NON in questo file. Il `.env` non va MAI committato.
# ============================================================

# --- Apify (sourcing Google Maps) ---
APIFY_TOKEN=

# --- Anthropic (scoring + hook) ---
ANTHROPIC_API_KEY=
# Modello LLM configurabile (default: Haiku)
LLM_MODEL=claude-haiku-4-5

# --- Google (PageSpeed + Sheets) ---
# API key per PageSpeed Insights (gratuita, consigliata per quote più alte)
PAGESPEED_API_KEY=
# ID del Google Sheet che fa da database di stato (dalla URL del foglio)
GOOGLE_SHEET_ID=
# Credenziali del service account: contenuto JSON *in una riga sola*
# oppure percorso al file (solo in locale)
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Telegram (consegna mattutina dei lead) ---
# Crea il bot con @BotFather su Telegram → token qui sotto.
# Il chat_id è il tuo: scrivi al bot, poi apri
# https://api.telegram.org/bot<TOKEN>/getUpdates e copia "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifiche email (report giornaliero) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
